# Base de données Postgres (ex : Neon, Vercel Postgres, Supabase).
# SQLite ne fonctionne pas de façon fiable en serverless (Vercel), d'où Postgres
# même pour le développement local — une base gratuite suffit largement pour la V1.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Mot de passe pour l'espace admin (agenda d'Eva)
ADMIN_PASSWORD="change-me"

# Clé secrète utilisée pour signer le cookie de session admin
ADMIN_SESSION_SECRET="change-me-too-please-use-a-long-random-string"
