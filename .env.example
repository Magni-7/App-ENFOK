# Base de données Postgres (ex : Neon, Vercel Postgres, Supabase).
# SQLite ne fonctionne pas de façon fiable en serverless (Vercel), d'où Postgres
# même pour le développement local — une base gratuite suffit largement pour la V1.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Mot de passe pour l'espace admin (agenda d'Eva)
ADMIN_PASSWORD="change-me"

# Clé secrète utilisée pour signer le cookie de session admin ET les
# cookies de session de l'espace client (lib/clientSession.ts)
ADMIN_SESSION_SECRET="change-me-too-please-use-a-long-random-string"

# Espace client : envoi des emails de connexion (lien magique) et de
# bienvenue via Resend (https://resend.com, offre gratuite suffisante
# pour démarrer). Créer un compte, récupérer une clé API.
RESEND_API_KEY="re_change_me"

# Adresse d'envoi. Par défaut le domaine de test Resend, qui ne délivre
# qu'à l'adresse du compte Resend — pour envoyer à de vraies clientes,
# vérifier un domaine (ex. trenzame.com) sur resend.com et mettre une
# adresse de ce domaine ici.
RESEND_FROM_EMAIL="Trenzame <onboarding@resend.dev>"

# Stockage des photos de la galerie (upload depuis /admin/galeria) via
# Vercel Blob. Sur Vercel : onglet "Storage" du projet → créer un store
# "Blob" et le connecter au projet — la variable est alors ajoutée
# automatiquement, pas besoin de la saisir à la main. En local, générer un
# token depuis ce même écran Vercel si besoin de tester l'upload.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_change_me"

# Sécurise l'endpoint /api/cron/send-review-requests, appelé une fois par
# jour par Vercel Cron (voir vercel.json) pour demander un avis aux clientes
# après leur cita. Sur Vercel : Settings → Environment Variables → générer
# une valeur aléatoire (ex. via `openssl rand -hex 32`) — Vercel ajoute
# alors automatiquement l'en-tête Authorization attendu à chaque appel cron.
CRON_SECRET="change-me-with-a-long-random-string"
