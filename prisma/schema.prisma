// Schéma de données — App de réservation de tresses (V1)
//
// Point d'architecture important : tout est rattaché à un "Professional".
// Pour cette V1 il n'y en a qu'un seul (Eva), mais aucune donnée n'est
// codée en dur pour un professionnel unique : Category, Style, Slot et
// Booking pointent tous vers un professionalId. Ajouter un deuxième
// professionnel plus tard ne demande pas de changement de schéma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Professional {
  id                  String   @id @default(cuid())
  slug                String   @unique
  displayName         String
  bio                 String?
  instagramHandle     String?
  instagramDmUsername String?
  whatsappNumber      String?

  // Note affichée en étoiles (sur 5) sur le profil et la page d'accueil.
  // Placeholder tant qu'il n'existe pas de vrai système d'avis clientes.
  rating              Float    @default(5)

  // Disponibilité : fenêtre de travail quotidienne (en minutes depuis minuit,
  // ex. 540 = 9h00, 1200 = 20h00), jours de repos (0 = dimanche .. 6 = samedi,
  // comme Date.getDay()) et marge de sécurité ajoutée après chaque rendez-vous
  // pour absorber les retards. Par défaut la fenêtre couvre les 24h (0-1440) :
  // une nouvelle professionnelle démarre ouverte en continu et choisit
  // ensuite ses propres horaires (Eva a déjà les siens, 9h-20h, définis dans
  // le seed). Modifiable par chaque professionnelle elle-même une fois
  // l'auto-inscription en place ; en attendant, Eva peut ajuster ses jours
  // de repos depuis /admin.
  workDayStartMinutes Int      @default(0)
  workDayEndMinutes   Int      @default(1440)
  daysOff             Int[]    @default([])
  bufferMinutes       Int      @default(30)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories Category[]
  styles     Style[]
  slots      Slot[]
  bookings   Booking[]
  salons     Salon[]
}

// Lieu physique où une professionnelle reçoit ses clientes (ex. un local
// partagé avec un barbershop). Une professionnelle peut à terme travailler
// depuis plusieurs lieux ; pour la V1 il n'y en a qu'un.
model Salon {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  photoUrl       String
  address        String?
  description    String?
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([professionalId, name])
}

// Les catégories sont des données modifiables (pas un enum figé dans le
// code) car les libellés exacts doivent être confirmés avec Eva et
// pourraient différer pour un futur deuxième professionnel.
model Category {
  id             String   @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  styles Style[]

  @@unique([professionalId, slug])
}

// SQLite ne supporte pas les enums natifs Prisma : on utilise une chaîne
// contrainte par convention ("CLIENT" | "PROFESSIONAL") au niveau applicatif.
model Style {
  id              String       @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])

  name            String
  description     String?
  basePriceCents  Int
  durationMinutes Int
  minHairLength   String
  // Valeurs attendues : "CLIENT" | "PROFESSIONAL" (voir lib/format.ts)
  hairProvidedBy  String       @default("CLIENT")
  isActive        Boolean      @default(true)
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  photos   StylePhoto[]
  bookings Booking[]
}

// Une seule photo suffit pour la V1, mais la relation one-to-many permet
// d'en ajouter d'autres plus tard sans migration de schéma.
model StylePhoto {
  id      String @id @default(cuid())
  styleId String
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  url     String
  alt     String?
  order   Int    @default(0)
}

model Slot {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  isBooked       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  booking Booking?

  @@index([professionalId, startAt])
}

// Valeurs attendues : "CONFIRMED" | "CANCELLED" (pas d'enum natif sous SQLite)
model Booking {
  id             String        @id @default(cuid())
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  styleId        String
  style          Style         @relation(fields: [styleId], references: [id])
  slotId         String        @unique
  slot           Slot          @relation(fields: [slotId], references: [id])

  // Rattachée au compte client si la cliente était connectée au moment de la
  // réservation ; reste optionnelle pour ne pas obliger à se connecter pour
  // réserver (voir /cuenta pour l'espace client).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  clientName  String
  clientPhone String
  clientEmail String?
  notes       String?
  status      String        @default("CONFIRMED")
  createdAt   DateTime      @default(now())
}

// Espace client : connexion classique par email + mot de passe. Le mot de
// passe n'est jamais stocké en clair (voir lib/password.ts, hachage scrypt).
model Client {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  bookings Booking[]
}
